{
  "$id": "urn:ats:schema:shadow-proposal:v1",
  "additionalProperties": false,
  "properties": {
    "account_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "title": "Account Id",
      "type": "string"
    },
    "candidate_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Candidate Digest",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "limit_price": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Limit Price"
    },
    "observation_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Observation Digest",
      "type": "string"
    },
    "proposal_id": {
      "format": "uuid",
      "title": "Proposal Id",
      "type": "string"
    },
    "quantity": {
      "minimum": 0,
      "title": "Quantity",
      "type": "integer"
    },
    "reason": {
      "maxLength": 1000,
      "minLength": 3,
      "title": "Reason",
      "type": "string"
    },
    "research_only": {
      "const": true,
      "default": true,
      "title": "Research Only",
      "type": "boolean"
    },
    "side": {
      "enum": [
        "BUY",
        "SELL",
        "HOLD"
      ],
      "title": "Side",
      "type": "string"
    },
    "symbol": {
      "pattern": "^[A-Z0-9]{6}$",
      "title": "Symbol",
      "type": "string"
    },
    "transmittable": {
      "const": false,
      "default": false,
      "title": "Transmittable",
      "type": "boolean"
    }
  },
  "required": [
    "proposal_id",
    "account_id",
    "candidate_digest",
    "observation_digest",
    "created_at",
    "symbol",
    "side",
    "quantity",
    "limit_price",
    "reason"
  ],
  "title": "ShadowProposal",
  "type": "object"
}
