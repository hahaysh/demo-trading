{
  "$defs": {
    "AccountHolding": {
      "additionalProperties": false,
      "properties": {
        "market_value": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Market Value"
        },
        "quantity": {
          "minimum": 0,
          "title": "Quantity",
          "type": "integer"
        },
        "sellable_quantity": {
          "minimum": 0,
          "title": "Sellable Quantity",
          "type": "integer"
        },
        "symbol": {
          "pattern": "^[A-Z0-9]{6}$",
          "title": "Symbol",
          "type": "string"
        }
      },
      "required": [
        "symbol",
        "quantity",
        "sellable_quantity",
        "market_value"
      ],
      "title": "AccountHolding",
      "type": "object"
    },
    "ObservedOrder": {
      "additionalProperties": false,
      "properties": {
        "filled": {
          "minimum": 0,
          "title": "Filled",
          "type": "integer"
        },
        "limit_price": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Limit Price"
        },
        "quantity": {
          "minimum": 0,
          "title": "Quantity",
          "type": "integer"
        },
        "received_at": {
          "format": "date-time",
          "title": "Received At",
          "type": "string"
        },
        "reference": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Reference",
          "type": "string"
        },
        "remaining": {
          "minimum": 0,
          "title": "Remaining",
          "type": "integer"
        },
        "side": {
          "enum": [
            "BUY",
            "SELL"
          ],
          "title": "Side",
          "type": "string"
        },
        "source": {
          "enum": [
            "HISTORY",
            "OPEN_ORDERS"
          ],
          "title": "Source",
          "type": "string"
        },
        "symbol": {
          "pattern": "^[A-Z0-9]{6}$",
          "title": "Symbol",
          "type": "string"
        }
      },
      "required": [
        "reference",
        "symbol",
        "side",
        "quantity",
        "filled",
        "remaining",
        "limit_price",
        "received_at",
        "source"
      ],
      "title": "ObservedOrder",
      "type": "object"
    },
    "ObservedQuote": {
      "additionalProperties": false,
      "properties": {
        "exchange_traded_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exchange Traded At"
        },
        "halted": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Halted"
        },
        "price": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Price"
        },
        "received_at": {
          "format": "date-time",
          "title": "Received At",
          "type": "string"
        },
        "status_code": {
          "title": "Status Code",
          "type": "string"
        },
        "symbol": {
          "pattern": "^[A-Z0-9]{6}$",
          "title": "Symbol",
          "type": "string"
        }
      },
      "required": [
        "symbol",
        "price",
        "received_at",
        "status_code"
      ],
      "title": "ObservedQuote",
      "type": "object"
    },
    "ReadReceipt": {
      "additionalProperties": false,
      "properties": {
        "account_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Account Id",
          "type": "string"
        },
        "binding": {
          "const": "REQUEST_BOUND_NOT_BROKER_SIGNED",
          "default": "REQUEST_BOUND_NOT_BROKER_SIGNED",
          "title": "Binding",
          "type": "string"
        },
        "mode": {
          "enum": [
            "SYNTHETIC",
            "PRODUCTION_READ_ONLY"
          ],
          "title": "Mode",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "operation": {
          "enum": [
            "BALANCE",
            "CAPACITY",
            "HISTORY",
            "OPEN_ORDERS",
            "QUOTE",
            "DAILY"
          ],
          "title": "Operation",
          "type": "string"
        },
        "permit_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Permit Digest",
          "type": "string"
        },
        "response_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Response Digest",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        }
      },
      "required": [
        "account_id",
        "operation",
        "permit_digest",
        "started_at",
        "observed_at",
        "response_digest",
        "mode"
      ],
      "title": "ReadReceipt",
      "type": "object"
    }
  },
  "$id": "urn:ats:schema:account-observation:v1",
  "additionalProperties": false,
  "properties": {
    "account_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "title": "Account Id",
      "type": "string"
    },
    "capacity_price": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Capacity Price"
    },
    "capacity_symbol": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Capacity Symbol"
    },
    "cash_flow_baseline_verified": {
      "const": false,
      "default": false,
      "title": "Cash Flow Baseline Verified",
      "type": "boolean"
    },
    "cash_orderable": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cash Orderable"
    },
    "credit_amount": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Credit Amount"
    },
    "deposit_balance": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Deposit Balance"
    },
    "external_reservations_verified": {
      "const": false,
      "default": false,
      "title": "External Reservations Verified",
      "type": "boolean"
    },
    "holdings": {
      "items": {
        "$ref": "#/$defs/AccountHolding"
      },
      "title": "Holdings",
      "type": "array"
    },
    "mode": {
      "enum": [
        "SYNTHETIC",
        "PRODUCTION_READ_ONLY"
      ],
      "title": "Mode",
      "type": "string"
    },
    "no_margin_buy_amount": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "No Margin Buy Amount"
    },
    "no_margin_buy_quantity": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "No Margin Buy Quantity"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "orders": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ObservedOrder"
      },
      "title": "Orders",
      "type": "array"
    },
    "quote": {
      "anyOf": [
        {
          "$ref": "#/$defs/ObservedQuote"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "receipts": {
      "items": {
        "$ref": "#/$defs/ReadReceipt"
      },
      "title": "Receipts",
      "type": "array"
    },
    "reservation_crosscheck": {
      "default": "UNKNOWN",
      "enum": [
        "MATCH",
        "DIFFERENT",
        "UNKNOWN"
      ],
      "title": "Reservation Crosscheck",
      "type": "string"
    },
    "securities_value": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Securities Value"
    },
    "snapshot_atomic": {
      "const": false,
      "default": false,
      "title": "Snapshot Atomic",
      "type": "boolean"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "total_equity": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Total Equity"
    },
    "uncertainties": {
      "default": [
        "CASH_FLOW_BASELINE_UNKNOWN",
        "RESERVATIONS_UNVERIFIED",
        "NON_ATOMIC_REST_SNAPSHOT"
      ],
      "items": {
        "type": "string"
      },
      "title": "Uncertainties",
      "type": "array"
    },
    "unsettled_receivable": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unsettled Receivable"
    }
  },
  "required": [
    "account_id",
    "mode",
    "started_at",
    "observed_at",
    "receipts",
    "holdings",
    "deposit_balance",
    "total_equity",
    "securities_value"
  ],
  "title": "ProductionAccountObservation",
  "type": "object"
}
