{
  "$defs": {
    "PolicyMetadata": {
      "additionalProperties": false,
      "properties": {
        "approved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approved At"
        },
        "approved_by": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 3,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approved By"
        },
        "owner": {
          "const": "operator",
          "default": "operator",
          "title": "Owner",
          "type": "string"
        },
        "policy_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Policy Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/PolicyStatus",
          "default": "DRAFT"
        },
        "version": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "policy_id",
        "version"
      ],
      "title": "PolicyMetadata",
      "type": "object"
    },
    "PolicyStatus": {
      "enum": [
        "DRAFT",
        "APPROVED",
        "RETIRED"
      ],
      "title": "PolicyStatus",
      "type": "string"
    }
  },
  "$id": "urn:ats:schema:read-only-access-permit:v1",
  "additionalProperties": false,
  "properties": {
    "account_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "title": "Account Id",
      "type": "string"
    },
    "agent_editable": {
      "const": false,
      "default": false,
      "title": "Agent Editable",
      "type": "boolean"
    },
    "binding_id": {
      "format": "uuid",
      "title": "Binding Id",
      "type": "string"
    },
    "credential_ref": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "title": "Credential Ref",
      "type": "string"
    },
    "enabled": {
      "default": false,
      "title": "Enabled",
      "type": "boolean"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "history_start": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "History Start"
    },
    "max_bytes": {
      "default": 1048576,
      "maximum": 4194304,
      "minimum": 1024,
      "title": "Max Bytes",
      "type": "integer"
    },
    "max_calls": {
      "default": 60,
      "maximum": 500,
      "minimum": 1,
      "title": "Max Calls",
      "type": "integer"
    },
    "max_pages": {
      "default": 20,
      "maximum": 20,
      "minimum": 1,
      "title": "Max Pages",
      "type": "integer"
    },
    "max_retries": {
      "default": 0,
      "maximum": 2,
      "minimum": 0,
      "title": "Max Retries",
      "type": "integer"
    },
    "max_seconds": {
      "default": 120,
      "maximum": 120,
      "minimum": 1,
      "title": "Max Seconds",
      "type": "integer"
    },
    "max_token_requests": {
      "default": 1,
      "maximum": 6,
      "minimum": 1,
      "title": "Max Token Requests",
      "type": "integer"
    },
    "metadata": {
      "$ref": "#/$defs/PolicyMetadata"
    },
    "operations": {
      "default": [
        "BALANCE"
      ],
      "items": {
        "enum": [
          "BALANCE",
          "CAPACITY",
          "HISTORY",
          "OPEN_ORDERS",
          "QUOTE",
          "DAILY"
        ],
        "type": "string"
      },
      "title": "Operations",
      "type": "array"
    },
    "rate_per_minute": {
      "default": 1,
      "maximum": 60,
      "minimum": 1,
      "title": "Rate Per Minute",
      "type": "integer"
    },
    "retain_observations": {
      "default": false,
      "title": "Retain Observations",
      "type": "boolean"
    },
    "source_id": {
      "default": "kis-market",
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "title": "Source Id",
      "type": "string"
    },
    "source_policy_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Source Policy Digest",
      "type": "string"
    },
    "starts_at": {
      "format": "date-time",
      "title": "Starts At",
      "type": "string"
    },
    "symbols": {
      "default": [],
      "items": {
        "pattern": "^[A-Z0-9]{6}$",
        "type": "string"
      },
      "title": "Symbols",
      "type": "array"
    },
    "synthetic_only": {
      "default": false,
      "title": "Synthetic Only",
      "type": "boolean"
    }
  },
  "required": [
    "metadata",
    "account_id",
    "credential_ref",
    "binding_id",
    "source_policy_digest",
    "starts_at",
    "expires_at"
  ],
  "title": "ReadOnlyAccessPermit",
  "type": "object"
}
