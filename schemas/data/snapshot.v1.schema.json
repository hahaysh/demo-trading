{
  "$defs": {
    "CredibilityTier": {
      "enum": [
        "PRIMARY",
        "LICENSED",
        "PUBLIC",
        "LOW_TRUST"
      ],
      "title": "CredibilityTier",
      "type": "string"
    },
    "PointInTimeRecord": {
      "additionalProperties": false,
      "description": "A source revision available to the system at a known observation time.",
      "properties": {
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "credibility_tier": {
          "$ref": "#/$defs/CredibilityTier"
        },
        "effective_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective At"
        },
        "instrument_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 3,
              "pattern": "^[a-z0-9][a-z0-9._-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instrument Id"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "raw_payload_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Raw Payload Digest",
          "type": "string"
        },
        "revision": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Revision",
          "type": "string"
        },
        "rights_class": {
          "$ref": "#/$defs/RightsClass"
        },
        "source_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Source Id",
          "type": "string"
        },
        "source_item_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Source Item Id",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "source_item_id",
        "revision",
        "observed_at",
        "rights_class",
        "credibility_tier",
        "content_hash",
        "raw_payload_digest"
      ],
      "title": "PointInTimeRecord",
      "type": "object"
    },
    "RightsClass": {
      "enum": [
        "PENDING_REVIEW",
        "APPROVED_PUBLIC",
        "LICENSED"
      ],
      "title": "RightsClass",
      "type": "string"
    },
    "UniverseMembershipManifest": {
      "additionalProperties": false,
      "description": "Content-addressed historical universe membership used by a snapshot.",
      "properties": {
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "manifest_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Manifest Id",
          "type": "string"
        }
      },
      "required": [
        "manifest_id",
        "as_of",
        "digest"
      ],
      "title": "UniverseMembershipManifest",
      "type": "object"
    }
  },
  "$id": "urn:ats:schema:data-snapshot:v1",
  "additionalProperties": false,
  "description": "A frozen, reproducible set of records available at a decision cutoff.",
  "properties": {
    "api_version": {
      "const": "ats/v1",
      "default": "ats/v1",
      "title": "Api Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "kind": {
      "const": "DataSnapshot",
      "default": "DataSnapshot",
      "title": "Kind",
      "type": "string"
    },
    "observed_through": {
      "format": "date-time",
      "title": "Observed Through",
      "type": "string"
    },
    "records": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PointInTimeRecord"
      },
      "title": "Records",
      "type": "array"
    },
    "snapshot_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "title": "Snapshot Id",
      "type": "string"
    },
    "universe_membership": {
      "$ref": "#/$defs/UniverseMembershipManifest"
    }
  },
  "required": [
    "snapshot_id",
    "observed_through",
    "created_at",
    "universe_membership"
  ],
  "title": "DataSnapshot",
  "type": "object"
}
